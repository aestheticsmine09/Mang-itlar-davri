<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Test</title>
    <link rel="stylesheet" href="style.css">
    <script>
        function checkAnswer() {
            var answer = document.getElementById("answer").value;
            if (answer.toLowerCase() === "buxoro") {
                alert("To‘g‘ri!");
            } else {
                alert("Noto‘g‘ri, qaytadan harakat qilib ko‘ring.");
            }
        }
    </script>
</head>
<body>
    <header>
        <h1>Test</h1>
    </header>
    <main>
        <p>Mang‘itlar davrida qaysi shahar poytaxt bo‘lgan?</p>
        <input type="text" id="answer">
        <button onclick="checkAnswer()">Tekshirish</button>
    </main>
</body>
